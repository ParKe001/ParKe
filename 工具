local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")

if RunService:IsStudio() then
    return
end

local function copyPlaceIdToClipboard()
    local placeId = game.PlaceId
    
    local success = pcall(function()
        if setclipboard then
            setclipboard(tostring(placeId))
            return true
        end
        
        local tempInput = Instance.new("TextBox")
        tempInput.Text = tostring(placeId)
        tempInput.Parent = game:GetService("CoreGui")
        tempInput:CaptureFocus()
        tempInput:SelectAll()
        
        wait(0.1)
        
        if rconsoleprint then
            rconsoleprint("地点ID: " .. placeId .. "\n")
        end
        
        tempInput:Destroy()
        return true
    end)
    
    if not success then
    end
end

local function autoCopyPlaceId()
    if not Players.LocalPlayer then
        Players:GetPropertyChangedSignal("LocalPlayer"):Wait()
    end
    
    wait(2)
    
    copyPlaceIdToClipboard()
    
    local player = Players.LocalPlayer
    if player and player:FindFirstChild("PlayerGui") then
        local screenGui = Instance.new("ScreenGui")
        local textLabel = Instance.new("TextLabel")
        
        screenGui.Name = "PlaceIdCopyNotification"
        screenGui.Parent = player.PlayerGui
        
        textLabel.Size = UDim2.new(0, 200, 0, 50)
        textLabel.Position = UDim2.new(0.5, -100, 0, 20)
        textLabel.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
        textLabel.TextColor3 = Color3.new(1, 1, 1)
        textLabel.Text = "地点ID已复制: " .. game.PlaceId
        textLabel.Font = Enum.Font.GothamBold
        textLabel.TextSize = 14
        textLabel.Parent = screenGui
        
        wait(3)
        screenGui:Destroy()
    end
end
